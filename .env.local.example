# Copy to .env.local and fill in from your Supabase project (Settings → API).

# Used by the Next.js app (client + server) — safe to expose, RLS/functions handle security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used ONLY by scripts/import.ts (never referenced by the Next.js app). Keep this out of
# Vercel's environment variables entirely — it only needs to exist on whatever machine
# runs the import script.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
